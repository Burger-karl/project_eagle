# ════════════════════════════════════════════════════════════
# PROJECT EAGLE — Environment Configuration
# Copy this to .env and fill in your real values
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════════

# ── Django ───────────────────────────────────────────────────
DJANGO_ENV=development          # development | production
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Middleware Database (PostgreSQL — your own Django DB) ────
# This is YOUR middleware database, NOT the Sage 200 database
# DB_NAME=project_eagle
# DB_USER=eagle_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Add this instead:
USE_SQLITE=True

# ── Sage 200 MSSQL Database (Client's restored .bak) ─────────
# These come from the client's SQL Server after you restore .bak
SAGE200_MSSQL_SERVER=DESKTOP-XXXX\SQLEXPRESS   # SQL Server instance name
SAGE200_MSSQL_DATABASE=your_sage200_db_name    # Name of restored database
SAGE200_MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Leave username/password blank for Windows Authentication
SAGE200_MSSQL_USERNAME=
SAGE200_MSSQL_PASSWORD=
SAGE200_MSSQL_TRUSTED_CONNECTION=yes           # yes = Windows Authentication

# ── Sage 200 REST API (for IRN write-back) ───────────────────
# From developer.sage.com after registering your app
SAGE200_CLIENT_ID=your_sage200_client_id
SAGE200_CLIENT_SECRET=your_sage200_client_secret
SAGE200_SITE_ID=your_site_id
SAGE200_COMPANY_ID=your_company_id
# Standard:     https://api.columbus.sage.com/uk/sage200/accounts/v1/
# Professional: https://api.columbus.sage.com/uk/sage200extra/accounts/v1/
SAGE200_API_BASE_URL=https://api.columbus.sage.com/uk/sage200/accounts/v1/

# ── FIRS MBS Credentials ─────────────────────────────────────
# From einvoice.firs.gov.ng after registering with client TIN
FIRS_API_KEY=your_firs_api_key
FIRS_SECRET_KEY=your_firs_secret_key
FIRS_TIN=client_tin_here
# False = sandbox (testing), True = live production
FIRS_USE_PRODUCTION=False
FIRS_SANDBOX_URL=https://sandbox.einvoice.firs.gov.ng/api/v1
FIRS_PRODUCTION_URL=https://einvoice.firs.gov.ng/api/v1

# ── Client Company Info (used in invoice header) ─────────────
CLIENT_COMPANY_NAME=Your Client Company Name
CLIENT_COMPANY_ADDRESS=Lagos, Nigeria
CLIENT_COMPANY_TIN=your_client_tin

# ── Celery / Redis (task queue) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CBN Exchange Rate API (foreign currency conversion) ───────
CBN_API_URL=https://www.cbn.gov.ng/rates/ExchRates.asp

# ── Sentry (production error tracking) ───────────────────────
SENTRY_DSN=your_sentry_dsn_here

# ── Email Alerts (failed invoice notifications) ───────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
ALERT_EMAIL=alerts@yourcompany.com
